<?xml version="1.0"?>
<launch>
    <arg name="camera1_ip" default="192.168.1.10"/>
    <arg name="camera2_ip" default="192.168.1.11"/>
    <arg name="camera_port" default="8090"/>

    <node pkg="orbbec_camera" type="gige_action_command_node"
          name="gige_action_command_node" output="screen"/>

    <include file="$(find orbbec_camera)/launch/gemini_330_series.launch">
        <arg name="camera_name" value="camera_01"/>
        <arg name="connection_delay" value="100"/>
        <arg name="enumerate_net_device" value="false"/>
        <arg name="ip_address" value="$(arg camera1_ip)"/>
        <arg name="port" value="$(arg camera_port)"/>
        <arg name="sync_mode" value="group_actions"/>
        <arg name="log_file_name" value="camera_01.log"/>
    </include>

    <include file="$(find orbbec_camera)/launch/gemini_330_series.launch">
        <arg name="camera_name" value="camera_02"/>
        <arg name="connection_delay" value="2100"/>
        <arg name="enumerate_net_device" value="false"/>
        <arg name="ip_address" value="$(arg camera2_ip)"/>
        <arg name="port" value="$(arg camera_port)"/>
        <arg name="sync_mode" value="group_actions"/>
        <arg name="log_file_name" value="camera_02.log"/>
    </include>
</launch>
